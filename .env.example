# Google Gemini API Key for long-context chat summarization & auto-naming
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model selection (supports 1,000,000+ token context window)
# Options: gemini-2.0-flash (recommended), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash
